{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/auth-return", "destination": "/auth-return.html" }
  ],
  "functions": {
    "api/*.js": {
      "regions": ["fra1"]
    }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
